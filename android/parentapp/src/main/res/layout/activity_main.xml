<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Parent Control" android:textSize="28sp" android:textStyle="bold" />

    <EditText android:id="@+id/backendUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Backend URL e.g. http://192.168.1.10:8080" android:inputType="textUri" />

    <EditText android:id="@+id/childId" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Child ID" android:text="child-001" />

    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="24dp" android:paddingBottom="16dp" android:text="Bedtime: OFF" android:textSize="22sp" />

    <Button android:id="@+id/btnOn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🌙 BEDTIME ON" />
    <Button android:id="@+id/btnOff" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="UNLOCK / BEDTIME OFF" />
</LinearLayout>
