<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parent Bedtime Control"
        android:textSize="28sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/parentChildId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:hint="Child ID"
        android:text="child-001" />

    <TextView
        android:id="@+id/parentStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Checking state..."
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnBedtimeOn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="BEDTIME ON" />

    <Button
        android:id="@+id/btnBedtimeOff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="BEDTIME OFF" />

    <Button
        android:id="@+id/btnRefreshState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="REFRESH STATUS" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Testing milestone: native parent control using the current Cloudflare backend. Secure pairing/authentication comes next."
        android:textSize="14sp" />
</LinearLayout>
