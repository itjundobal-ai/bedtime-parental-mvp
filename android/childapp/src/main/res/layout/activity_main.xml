<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Child Bedtime Setup"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setupStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="STEP 1 OF 4 — Prepare device"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bago mag-Device Owner setup: alisin muna ang saved accounts at siguraduhing alam ninyo ang login details bago alisin. Maaari silang ibalik pagkatapos ng setup." />

        <Button
            android:id="@+id/btnAccountsSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. PUNTA SA ACCOUNTS / ACCOUNT &amp; SECURITY" />

        <Button
            android:id="@+id/btnContinueSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="2. TAPOS NA — CONTINUE SETUP" />

        <TextView
            android:id="@+id/deviceOwnerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Device Owner: checking..."
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deviceOwnerHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="" />

        <EditText
            android:id="@+id/backendUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Backend URL"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/childId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Child ID"
            android:text="child-001" />

        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Fallback only: Allow Display Over Apps" />

        <Button
            android:id="@+id/btnStartMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3. START BEDTIME MONITOR" />

        <Button
            android:id="@+id/btnTestOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TEST BEDTIME" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Setup not finished" />
    </LinearLayout>
</ScrollView>
