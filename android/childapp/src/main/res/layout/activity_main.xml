<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Child Bedtime Setup" android:textSize="26sp" android:textStyle="bold" />
<TextView android:id="@+id/setupStep" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="STEP 1 OF 5 — Prepare device" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Alisin muna ang saved accounts. Pagkatapos ay i-activate ang Device Owner at kumpletuhin ang battery/background setup." />
<Button android:id="@+id/btnAccountsSecurity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="1. PUNTA SA ACCOUNTS / ACCOUNT &amp; SECURITY" />
<Button android:id="@+id/btnContinueSetup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="2. TAPOS NA — CONTINUE SETUP" />
<TextView android:id="@+id/deviceOwnerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Device Owner: checking..." android:textStyle="bold" />
<TextView android:id="@+id/deviceOwnerHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
<EditText android:id="@+id/backendUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="Backend URL" android:inputType="textUri" />
<EditText android:id="@+id/childId" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Child ID" android:text="child-001" />
<Button android:id="@+id/btnOverlayPermission" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="3. Fallback only: Allow Display Over Apps" />
<Button android:id="@+id/btnStartMonitor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="4. START BEDTIME MONITOR" />
<Button android:id="@+id/btnBatterySettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="5. BATTERY — NO RESTRICTIONS" android:visibility="gone" />
<Button android:id="@+id/btnAutoRunSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="6. AUTO-RUN / BACKGROUND APPS" android:visibility="gone" />
<Button android:id="@+id/btnSaveRestart" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="SAVE &amp; RESTART MONITOR" android:visibility="gone" />
<Button android:id="@+id/btnRestoreAccounts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="IBALIK / ADD ULIT ANG MGA ACCOUNT" android:visibility="gone" />
<Button android:id="@+id/btnTestOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="TEST BEDTIME" />
<Button android:id="@+id/btnReleaseDeviceOwner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="TEST ONLY — RELEASE DEVICE OWNER" android:visibility="gone" />
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="24dp" android:text="Setup not finished" />
</LinearLayout></ScrollView>