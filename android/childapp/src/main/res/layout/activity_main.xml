<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Child Bedtime Setup" android:textSize="26sp" android:textStyle="bold" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Bago mag-Device Owner setup: alisin muna ang saved accounts at siguraduhing alam ninyo ang login details bago alisin. Maaari silang ibalik pagkatapos ng setup." />

    <Button android:id="@+id/btnAccountsSecurity" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="0. Accounts / Account &amp; Security" />

    <EditText android:id="@+id/backendUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Backend URL e.g. http://192.168.1.10:8080" android:inputType="textUri" />
    <EditText android:id="@+id/childId" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Child ID" android:text="child-001" />

    <Button android:id="@+id/btnOverlayPermission" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="1. Allow Display Over Apps" />
    <Button android:id="@+id/btnStartMonitor" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="2. Start Bedtime Monitor" />
    <Button android:id="@+id/btnTestOverlay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="TEST BEDTIME OVERLAY" />

    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="24dp" android:text="Monitor stopped" />
</LinearLayout>
